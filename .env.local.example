# Firebase Admin SDK (Server) — aus Firebase Console > Projekteinstellungen > Dienstkonten
# "Neuen privaten Schlüssel generieren" -> JSON-Datei, Werte hier eintragen.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private Key mit \n als literale Zeichenfolge fuer Zeilenumbrueche einfuegen (in Anfuehrungszeichen)
FIREBASE_PRIVATE_KEY=""

# Firebase Web SDK (nur fuer den Admin-Login im Browser, KEINE geheimen Werte)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App-Secrets (mit `openssl rand -hex 32` erzeugen)
APP_HMAC_SECRET=
SESSION_SECRET=
# Exakt 32 Byte Hex (64 Zeichen) - mit `openssl rand -hex 32` erzeugen
ACCESS_CODE_ENCRYPTION_KEY=

# Basis-URL der Anwendung (nicht-personalisierter Anmeldelink im XLSX-Export)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin-Bootstrap (nur fuer scripts/bootstrap-admin.ts, danach entfernen/nicht deployen)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
